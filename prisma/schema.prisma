// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["extendedIndexes"]

}

datasource db {
 provider          = "postgresql"
  url               = env("DATABASE_URL")
}


model Organization {
  id                      String                  @id @default(cuid())
  name                    String                  @unique
  users                   User[]
  workspaces              Workspace[]
  domains                 Domain[]
  designElements          DesignElement[]
  mediaFiles              MediaFile[]
  products                Product[]
  aIConfigs               AIConfig[]
  designElementVersions   DesignElementVersion[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model User {
  id                      String                  @id @default(cuid())
  email                   String                  @unique
  username                String                  @unique
  password                String
  role                    Role                    @default(USER)
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  mediaFiles              MediaFile[]
  workspaces              Workspace[]
  designElementVersions   DesignElementVersion[]
  products                Product[]
  collaborations          Collaboration[]
  exportedDesigns         ExportedDesign[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  Segment Segment[] @relation("UserSegment")

  UserSegment UserSegment[]
}

model Product {
  id                      String                  @id @default(cuid())
  name                    String
  description             String
  price                   Float
  quantity                Int
  category                String
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  createdBy               User                    @relation(fields: [createdById], references: [id])
  createdById             String
  primaryPhoto            String?
  imageGallery            String[]
  ogImage                 String?
  metadata                Json?
  versions                ProductVersion[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  designConcepts          DesignConcept[]
  aiSuggestions           AISuggestion[]

  Segment Segment[]
}

model ProductVersion {
  id                      String                  @id @default(cuid())
  versionNumber           Int
  product                 Product                 @relation(fields: [productId], references: [id])
  productId               String
  changes                 String
  data                    Json
  createdAt               DateTime                @default(now())
}

model AIConfig {
  id                      String                  @id @default(cuid())
  nlpSensitivity          Int
  aiCreativity            Int
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model AISuggestion {
  id                      String                  @id @default(cuid())
  content                 String
  product                 Product                 @relation(fields: [productId], references: [id])
  productId               String
  createdAt               DateTime                @default(now())
}

model DesignConcept {
  id                      String                  @id @default(cuid())
  title                   String
  image                   String
  product                 Product                 @relation(fields: [productId], references: [id])
  productId               String
  createdAt               DateTime                @default(now())
}

model Domain {
  id                      String                  @id @default(cuid())
  domain                  String                  @unique
  designElements          DesignElement[]
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  segments                Segment[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Segment {
  id        String      @id @default(uuid())
  name      String
  slug      String?
  users     User[]      @relation("UserSegment") // Relation to users
  segments  UserSegment[] // Relation to the UserSegment pivot model
  post      Json?
  productVersion String?
  productId String?
  product    Product?     @relation(fields: [productId], references: [id])

  // This defines a many-to-one relationship where a segment belongs to a domain
  domainId  String? 
  domain    Domain?     @relation(fields: [domainId], references: [id])
}


model UserSegment {
  id        String   @id @default(uuid())
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
  segment   Segment?  @relation(fields: [segmentId], references: [id])
  segmentId String?
  // Define user segment fields
}

model DesignElement {
  id                      String                  @id @default(cuid())
  domain                  Domain                  @relation(fields: [domainId], references: [id])
  domainId                String
  elementType             ElementType
  currentVersion          Int                     @default(1)
  versions                DesignElementVersion[]
  mediaFiles              MediaFile[]
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  workspaceElements       WorkspaceElement[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  attributions            Attribution[]
  blockchainHash          String?
  ipfsHash                String?
}

model DesignElementVersion {
  id                      String                  @id @default(cuid())
  versionNumber           Int
  designElement           DesignElement           @relation(fields: [designElementId], references: [id])
  designElementId         String
  elementData             Json
  mediaFiles              MediaFile[]
  screenshot              String
  createdBy               User                    @relation(fields: [createdById], references: [id])
  createdById             String
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  createdAt               DateTime                @default(now())
  blockchainHash          String?
  ipfsHash                String?
}

model MediaFile {
  id                      String                  @id @default(cuid())
  name                    String
  url                     String
  type                    MediaType
  user                    User?                   @relation(fields: [userId], references: [id])
  userId                  String?
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  designElements          DesignElement[]
  designElementVersions   DesignElementVersion[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  attribution             Attribution?            @relation(fields: [attributionId], references: [id])
  attributionId           String?
  blockchainHash          String?
  ipfsHash                String?
}

model Workspace {
  id                      String                  @id @default(cuid())
  name                    String
  organization            Organization            @relation(fields: [organizationId], references: [id])
  organizationId          String
  users                   User[]
  workspaceElements       WorkspaceElement[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  ExportedDesign ExportedDesign[]

  Collaboration Collaboration[]
}

model WorkspaceElement {
  id                      String                  @id @default(cuid())
  workspace               Workspace               @relation(fields: [workspaceId], references: [id])
  workspaceId             String
  designElement           DesignElement           @relation(fields: [designElementId], references: [id])
  designElementId         String
  elementData             Json
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Attribution {
  id                      String                  @id @default(cuid())
  author                  String
  source                  String
  license                 String
  designElements          DesignElement[]
  mediaFiles              MediaFile[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model Collaboration {
  id                      String                  @id @default(cuid())
  user                    User                    @relation(fields: [userId], references: [id])
  userId                  String
  workspace               Workspace               @relation(fields: [workspaceId], references: [id])
  workspaceId             String
  role                    CollaborationRole       @default(VIEWER)
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

model ExportedDesign {
  id                      String                  @id @default(cuid())
  workspace               Workspace               @relation(fields: [workspaceId], references: [id])
  workspaceId             String
  user                    User                    @relation(fields: [userId], references: [id])
  userId                  String
  format                  ExportFormat
  url                     String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
}

enum Role {
  ADMIN
  USER
}

enum ElementType {
  COLOR
  FONT
  IMAGE
  AUDIO
  VIDEO
  SHAPE
  TEXT
}

enum MediaType {
  IMAGE
  AUDIO
  VIDEO
}

enum CollaborationRole {
  EDITOR
  VIEWER
}

enum ExportFormat {
  PNG
  JPG
  SVG
  PDF
}